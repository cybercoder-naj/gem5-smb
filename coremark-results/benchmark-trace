#!/usr/bin/env bash

set -e

# Usage: ./coremark-results/benchmark <prog> [--debug-start <tick>]
pwd=$(dirname $0)
prog=$1
shift

debug_start=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --debug-start)
      debug_start="--debug-start=$2"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1"
      exit 1
      ;;
  esac
done


scons build/X86/gem5.opt --ignore-style -j$(nproc)
g++ -O3 -o memprofile memprofile.cc

if ! which $prog; then
  echo "Error: $prog not found in PATH"
  exit 1
fi
cmd=$(which $prog)

# basename is prog filename without path, with extension
basename=$(basename $cmd)
filename="${basename%.*}"

config="--cpu-type=DerivO3CPU --caches --l2cache --l1d_size=64KiB --l1i_size=64KiB --l2_size=2MB --l1d-hwp-type=StridePrefetcher --l1i-hwp-type=StridePrefetcher --l2-hwp-type=StridePrefetcher"

export SMB_PREDICTIONS_FILE="$HOME/memtraces-v2/$filename.predictions"
systemd-run --user --slice=workloads.slice --scope ./build/X86/gem5.opt \
  --debug-flags=O3CPUAll \
  --debug-file=../$pwd/$filename-smb-trace.out.gz \
  $debug_start \
  configs/deprecated/example/se.py \
  --cmd="$cmd" \
  $config \
  -o="-i1 -v0"
cp m5out/stats.txt $pwd/$filename-debug-stats-smb.txt
