#!/usr/bin/env bash

set -e

# Usage: ./coremark-results/benchmark <prog>
pwd=$(dirname $0)
prog=$1

scons build/X86/gem5.fast --ignore-style -j$(nproc)

if ! which $prog; then
  echo "Error: $prog not found in PATH"
  exit 1
fi
cmd=$(which $prog)

# basename is prog filename without path, with extension
basename=$(basename $cmd)
filename="${basename%.*}"

config="--cpu-type=DerivO3CPU --caches --l2cache --l1d_size=64KiB --l1i_size=64KiB --l2_size=2MB --l1d-hwp-type=StridePrefetcher --l1i-hwp-type=StridePrefetcher --l2-hwp-type=StridePrefetcher"

export MEM_TRACE_FILE="$pwd/$filename.memtrace"
echo "" > $MEM_TRACE_FILE
systemd-run --user --slice=workloads.slice --scope ./build/X86/gem5.fast \
  configs/deprecated/example/se.py \
  $config \
  --cmd="$cmd"

cp m5out/stats.txt $pwd/$filename-stats-no-smb.txt
export SMB_PREDICTIONS_FILE="$pwd/$filename.predictions"
echo "" > $SMB_PREDICTIONS_FILE
./memprofile $MEM_TRACE_FILE $SMB_PREDICTIONS_FILE

unset MEM_TRACE_FILE
systemd-run --user --slice=workloads.slice --scope ./build/X86/gem5.fast \
  configs/deprecated/example/se.py \
  $config \
  --cmd="$cmd"  

cp m5out/stats.txt $pwd/$filename-stats-smb.txt