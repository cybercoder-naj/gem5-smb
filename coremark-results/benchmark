#!/usr/bin/env bash

set -e

# Usage: ./coremark-results/benchmark <prog>
pwd=$(dirname $0)
prog=$1

scons build/X86/gem5.opt --ignore-style -j$(nproc)
g++ -O3 -o memprofile memprofile.cc

if ! which $prog; then
  echo "Error: $prog not found in PATH"
  exit 1
fi
cmd=$(which $prog)

# basename is prog filename without path, with extension
basename=$(basename $cmd)
filename="${basename%.*}"

config="--cpu-type=DerivO3CPU \
    --caches --l2cache \
    --l1d_size=64KiB --l1i_size=64KiB --l2_size=2MB \
    --l1d-hwp-type=StridePrefetcher \
    --l1i-hwp-type=StridePrefetcher \
    --l2-hwp-type=StridePrefetcher"

# export MEM_TRACE_FILE="$HOME/memtraces-v2/$filename.memtrace"
export SMB_PREDICTIONS_FILE="$HOME/memtraces-v2/$filename.predictions"
systemd-run --user --slice=workloads.slice --scope ./build/X86/gem5.opt \
  --outdir=m5out/$filename/smb \
  --debug-flags=SMBCoverage \
  --debug-file=smb-coverage.gz \
  configs/deprecated/example/se.py \
  --cmd="$cmd" \
  $config \
  --options="-i1 -v0"

cp m5out/$filename/smb/stats.txt $pwd/$filename-stats-smb.txt
cp m5out/$filename/smb/smb-coverage.txt $pwd/$filename-smb-coverage.txt
